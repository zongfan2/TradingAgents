# Preset B — Claude Sonnet 5，走本地 claude-max-api-proxy（Claude Pro/Max 订阅）
# 需要先启动代理（默认端口 3456），步骤见 compare/README.md
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_LLM_BACKEND_URL=http://localhost:3456/v1
# "sonnet" 是代理的模型别名，映射到 claude CLI 当前的 Sonnet（即 Sonnet 5）。
# 注意：代理对不认识的模型名会静默回落到 Opus，所以先用文档别名，
# 启动代理后可用 GET /v1/models 确认可用 ID。
TRADINGAGENTS_DEEP_THINK_LLM=sonnet
TRADINGAGENTS_QUICK_THINK_LLM=sonnet

# 对比公共参数（三个 preset 保持一致，改动请同步）
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
