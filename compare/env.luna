# Preset C — GPT-5.6 Luna，OpenAI 按量 API 直连（占位：等 .env 里填 OPENAI_API_KEY 后即可用）
# Luna 定价 $1/$6 每百万 token（2026-07-10 随 GPT-5.6 家族发布）。
# 模型不在仓库 catalog 里，启动时会有一条 RuntimeWarning "not in the known
# model list ... Continuing anyway"，属预期，可忽略。
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.6-luna
TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.6-luna

# 对比公共参数（三个 preset 保持一致，改动请同步）
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
